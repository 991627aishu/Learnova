{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node -e \"const cp=require('child_process'); const run=()=>{ const p=cp.spawn('npm', ['run', 'dev:inner'], {stdio:'inherit', shell:true}); p.on('exit', (code)=>{ if(code!==0){ console.log('Backend crashed, restarting in 3s...'); setTimeout(run, 3000); } }); }; run();\"",
    "dev:backend": "npm run dev",
    "dev:inner": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "reset:db": "tsx src/scripts/resetDatabase.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.71.1",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "katex": "^0.16.45",
    "marked": "^18.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.7",
    "openai": "^6.33.0",
    "puppeteer": "^24.40.0",
    "puppeteer-core": "^24.42.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "stripe": "^22.0.0",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "ws": "^8.20.0",
    "y-websocket": "^1.5.0",
    "yjs": "^13.6.30",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.18.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
